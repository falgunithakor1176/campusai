# CampusAI Client - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── API Configuration ─────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api

# ─── App Info ──────────────────────────────────────────────────────────────
VITE_APP_NAME=CampusAI
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Intelligent College Assistant

# ─── Feature Flags ─────────────────────────────────────────────────────────
# Number of queries a guest user can ask before being prompted to register
VITE_GUEST_QUERY_LIMIT=5

# Enable/disable features (true/false)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PDF_UPLOAD=true
VITE_ENABLE_VOICE_INPUT=false

# ─── External Services ─────────────────────────────────────────────────────
# Add any public API keys here (non-secret only!)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
