# ============================================================
# CampusAI Server - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://campusai_user:campusai_pass@localhost:5432/campusai_db

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads/documents

# Storage Provider: 'local' | 's3' | 'supabase'
STORAGE_PROVIDER=local

# AWS S3 (optional - for future use)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20
GUEST_DAILY_QUERY_LIMIT=5

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
